# 复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）

# 通用 API 层的默认 baseURL。留空则 request() 的 url 参数必须写完整地址。
# 示例：VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# 单次请求超时（毫秒）
VITE_API_TIMEOUT_MS=10000

# 默认重试次数（仅对 network / timeout / 5xx 生效，4xx 与 abort 不重试）
VITE_API_RETRIES=1

# 是否向第三方图标服务请求网站图标。设为 false 则只显示首字母（不发外部请求）。
VITE_FAVICON_ENABLED=true
